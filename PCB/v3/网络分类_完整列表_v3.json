  "special_handling": [
    {"id": 1, "item": "Kelvin tap from Rsns pad end", "reason": "Shared power copper -> 5% measurement error"},
    {"id": 2, "item": "D2/D8 close to MOSFET gate <5mm", "reason": "Parasitic inductance delays TVS clamping"},
    {"id": 3, "item": "B+/PACK-/$2N586/NET1 + SRN_INA power segment manual widen to >=3mm", "reason": "3A continuous current, 1mm insufficient"},
    {"id": 4, "item": "Decoupling cap 100nF <5mm from IC power pin", "reason": "Parasitic inductance kills HF decoupling"},
    {"id": 5, "item": "SW copper area <=50mm2 (only U5.1->D4->L1)", "reason": "Excess area significantly increases radiation"},
    {"id": 6, "item": "I2C daisy chain not star; measure and touch I2C independent", "reason": "Stub reflection + address conflict"}
